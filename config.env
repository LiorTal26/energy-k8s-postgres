# ==============================================================================
# Global Project Configuration (Single Source of Truth)
# ==============================================================================
# WHAT THIS FILE DOES:
# This file serves as the centralized configuration for the entire repository.
#
# HOW IT AFFECTS THE ENTIRE PROCESS:
# 1. Automation Scripts: All PowerShell (*.ps1) and Bash (*.sh) scripts
#    (bootstrap, verify, test-failover, test-network-policy, destroy) dynamically
#    import these variables via their respective loaders (env.ps1 / env.sh).
# 2. Manual CLI Sessions: Dot-sourcing the loaders in your shell exports these
#    variables and the project KUBECONFIG for interactive kubectl/helm/psql use.
# 3. Dynamic Propagation: Changing a value here (e.g. cluster name, namespace,
#    chart version, or release names) immediately updates the target Kubernetes
#    contexts, Helm releases, Secret lookups, and test probes across both platforms
#    without requiring any script code modifications.
# ==============================================================================

CLUSTER_NAME=energy-team
NAMESPACE=postgres-operator
DATABASE_RELEASE=energy-pg
OPERATOR_RELEASE=percona-operator
OPERATOR_DEPLOYMENT=percona-operator-pg-operator
CHART_VERSION=3.0.0
CREDENTIAL_SECRET=energy-pg-pguser-energyapp
DATABASE_SERVICE=energy-pg-pgbouncer
JOB_NAME=postgres-smoke-test
AUTHORIZED_JOB=np-authorized-probe
UNAUTHORIZED_JOB=np-unauthorized-probe
